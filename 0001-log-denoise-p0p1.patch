diff --git a/service/src/business/intent_recognition/intent_recognition_service.cpp b/service/src/business/intent_recognition/intent_recognition_service.cpp
index c6c16b0..9053452 100644
--- a/service/src/business/intent_recognition/intent_recognition_service.cpp
+++ b/service/src/business/intent_recognition/intent_recognition_service.cpp
@@ -21,7 +21,7 @@ void IntentRecognitionService::AddIntentClarificationResult(const std::string& r
 {
     std::lock_guard<std::mutex> lock(m_clarificationMutex);
     m_clarificationMap[responseId] = result;
-    LOG_INFO("[IntentRecognition] Add intent clarification result, responseId: %s", responseId.c_str());
+    LOG_DEBUG("[IntentRecognition] Add intent clarification result, responseId: %s", responseId.c_str());
 }
 
 std::shared_ptr<IntentClarificationResult> IntentRecognitionService::GetIntentClarificationResultWithoutWait(const std::string& responseId)
@@ -41,7 +41,7 @@ void IntentRecognitionService::RecognizeIntent(const std::string& userId,
                                               const std::string& originalContent,
                                               const std::string& responseId)
 {
-    LOG_INFO("[IntentRecognition] Start intent recognition, responseId: %s", responseId.c_str());
+    LOG_DEBUG("[IntentRecognition] Start intent recognition, responseId: %s", responseId.c_str());
     auto start = std::chrono::system_clock::now();
     // 创建 IntentClarificationResult 对象并添加到缓存
     auto intentResultObj = std::make_shared<IntentClarificationResult>(responseId);
@@ -49,7 +49,7 @@ void IntentRecognitionService::RecognizeIntent(const std::string& userId,
     
     // 第一步：关键字检测（通过数据库查询）
     if (!HasDeleteMemoryKeyword(originalContent)) {
-        LOG_INFO("[IntentRecognition] No delete memory keyword found, skip.");
+        LOG_DEBUG("[IntentRecognition] No delete memory keyword found, skip.");
         UpdateIntentClarificationResult(responseId, "None", 0);
         return;
     }
@@ -136,7 +136,7 @@ std::string IntentRecognitionService::DoIntentInfer(const std::string& query)
 
 void IntentRecognitionService::UpdateIntentClarificationResult(const std::string& responseId, const std::string& intentResult, const long latency)
 {
-    LOG_INFO("[IntentRecognition] UpdateIntentClarificationResult, responseId: %s, intentResult: %s",
+    LOG_DEBUG("[IntentRecognition] UpdateIntentClarificationResult, responseId: %s, intentResult: %s",
              responseId.c_str(), intentResult.c_str());
     
     // 获取 IntentClarificationResult 并更新意图结果（不带等待，避免死锁）
@@ -148,7 +148,7 @@ void IntentRecognitionService::UpdateIntentClarificationResult(const std::string
             result->intentLatency = latency;
         }
         result->intentCv.notify_all();
-        LOG_INFO("[IntentRecognition] IntentClarificationResult updated successfully.");
+        LOG_DEBUG("[IntentRecognition] IntentClarificationResult updated successfully.");
     } else {
         LOG_ERR("[IntentRecognition] IntentClarificationResult not found for responseId: %s", responseId.c_str());
     }
@@ -183,7 +183,7 @@ void IntentRecognitionService::RemoveIntentClarificationResult(const std::string
     std::lock_guard<std::mutex> lock(m_clarificationMutex);
     auto it = m_clarificationMap.find(responseId);
     if (it != m_clarificationMap.end()) {
-        LOG_INFO("[IntentRecognition] Remove IntentClarificationResult, responseId: %s", responseId.c_str());
+        LOG_DEBUG("[IntentRecognition] Remove IntentClarificationResult, responseId: %s", responseId.c_str());
         m_clarificationMap.erase(it);
     }
 }
