  {
    "id": "TC001",
    "description": "先获取访问令牌，把用户 U1003 的邮箱改成 u1003.stable@example.com，职级调整为 Senior Engineer，随后拉取 U1003 的详情；以最后这次详情查询的返回为准。",
    "assert": {
      "expectedStatus": 200,
      "expectedFields": [
        "code",
        "data.userId",
        "data.email",
        "data.title"
      ],
      "expectedValues": {
        "code": 0,
        "data.userId": "U1003",
        "data.email": "u1003.stable@example.com",
        "data.title": "Senior Engineer"
      }
    }
