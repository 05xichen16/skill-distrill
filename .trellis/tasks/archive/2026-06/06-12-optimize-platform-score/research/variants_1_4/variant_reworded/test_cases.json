  {
    "id": "TC007",
    "description": "把处于活跃状态的用户列出来，停在第一页、每页一百条、升序；核对分页、总条数以及第 100 条记录。",
    "assert": {
      "expectedStatus": 200,
      "expectedFields": [
        "code",
        "data.page",
        "data.pageSize",
        "data.total",
        "data.list.0.userId",
        "data.list.99.userId"
      ],
      "expectedValues": {
        "code": 0,
        "data.page": 1,
        "data.pageSize": 100,
        "data.total": 240,
        "data.list.0.userId": "U2001",
        "data.list.99.userId": "U2100"
      }
    }
  },
