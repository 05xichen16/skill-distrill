  {
    "id": "TC006",
    "description": "在平台部门里翻到第二页、每页两条、按升序排列地列出用户；核对分页信息以及列表里的第一条。",
    "assert": {
      "expectedStatus": 200,
      "expectedFields": [
        "code",
        "data.page",
        "data.pageSize",
        "data.total",
        "data.list.0.userId",
        "data.list.0.name"
