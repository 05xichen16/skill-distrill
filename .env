MODEL_CHAT_COMPLETIONS_URL=http://codingcontest-ai-xian.rnd.huawei.com/model/v1/chat/completions
MODEL_BASE_URL=http://codingcontest-ai-xian.rnd.huawei.com/model/v1
MODEL_API_KEY=sk-AgentCompetition-AgentCompetition
MODEL_NAME=fuyao-Qwen3.5

AGENT_DEMO_USE_LLM=1
AGENT_DEMO_NATIVE_TOOLS=1
AGENT_DEMO_JSON_TOOL_FALLBACK=1

AGENT_DEMO_MAX_ITER=6
AGENT_DEMO_TEMPERATURE=0.2
AGENT_DEMO_TIMEOUT_SECONDS=120
AGENT_DEMO_MAX_TOKENS=4096
AGENT_DEMO_STREAM=1

# Thinking/token trade-off: on by default for correctness; Phase B can route per question.
AGENT_DEMO_ENABLE_THINKING=1
# Transient gateway error retries (exponential backoff).
AGENT_DEMO_MAX_RETRIES=2
AGENT_DEMO_RETRY_BACKOFF=1.0
# Cross-question concurrency. 1 = serial (default). Raise to fight the 1-hour cap.
AGENT_DEMO_CONCURRENCY=1
