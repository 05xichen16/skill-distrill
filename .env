MODEL_CHAT_COMPLETIONS_URL=http://codingcontest-ai-xian.rnd.huawei.com/model/v1/chat/completions
MODEL_BASE_URL=http://codingcontest-ai-xian.rnd.huawei.com/model/v1
MODEL_API_KEY=sk-AgentCompetition-AgentCompetition
MODEL_NAME=fuyao-Qwen3.5

AGENT_DEMO_USE_LLM=1
AGENT_DEMO_NATIVE_TOOLS=1
AGENT_DEMO_JSON_TOOL_FALLBACK=1

AGENT_DEMO_MAX_ITER=6
AGENT_DEMO_TEMPERATURE=0.2
AGENT_DEMO_TIMEOUT_SECONDS=120
AGENT_DEMO_MAX_TOKENS=4096
AGENT_DEMO_STREAM=1

# Thinking/token+latency trade-off: OFF by default. thinking ~10x's per-call latency and the
# 1-hour run cap (任务书) makes it the dominant cost — with it on, the serial run only reached
# ~4 of 10 questions. Known questions score equal-or-better off (3_1 85%>75%, 2_2/1_2 off).
AGENT_DEMO_ENABLE_THINKING=0
# Per-question thinking allowlist (comma-separated question ids, e.g. 3_3,2_3). Empty = none.
# Listed ids run the main agent loop with thinking ON without any code change; skills stay off.
AGENT_DEMO_THINKING_QUESTION_IDS=
# Single-question probe for platform variance debugging. When set (comma-separated ids,
# e.g. 3_2 or 3_2,1_4), ONLY the listed questions run the full solve flow; every other
# question instantly returns an empty answer (zero model calls, zero skill subprocesses).
# A whitelist matching no real id is ignored with a loud warning and the run stays FULL,
# so a typo can never submit all-empty. Leaderboard keeps the LATEST submission's score:
# the closing/final submission MUST be a full run with this line left commented out.
# AGENT_DEMO_ONLY_QUESTION_IDS=3_2
# Transient gateway error retries (exponential backoff).
AGENT_DEMO_MAX_RETRIES=2
AGENT_DEMO_RETRY_BACKOFF=1.0
# Cross-question concurrency: ENABLED at 3 to fight the 1-hour cap (serial run only reached
# ~4 of 10 questions). Wall-clock changes from sum-of-questions toward max-of-questions.
# WARNING: peak gateway in-flight requests ≈ concurrency × per-question skill workers
# (PROMPT_LEARN_WORKERS / SPEC_QA_WORKERS default 4 → peak ≈ 12). If the gateway throttles
# or RemoteDisconnect appears, lower this value.
AGENT_DEMO_CONCURRENCY=3
