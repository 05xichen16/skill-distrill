MODEL_CHAT_COMPLETIONS_URL=http://codingcontest-ai-xian.rnd.huawei.com/model/v1/chat/completions
MODEL_BASE_URL=http://codingcontest-ai-xian.rnd.huawei.com/model/v1
MODEL_API_KEY=sk-AgentCompetition-AgentCompetition
MODEL_NAME=fuyao-Qwen3.5

AGENT_DEMO_USE_LLM=1
AGENT_DEMO_NATIVE_TOOLS=1
AGENT_DEMO_JSON_TOOL_FALLBACK=1

AGENT_DEMO_MAX_ITER=6
AGENT_DEMO_TEMPERATURE=0.2
AGENT_DEMO_TIMEOUT_SECONDS=120
AGENT_DEMO_MAX_TOKENS=4096
AGENT_DEMO_STREAM=1

# Thinking/token+latency trade-off: OFF by default. thinking ~10x's per-call latency and the
# 1-hour run cap (任务书) makes it the dominant cost — with it on, the serial run only reached
# ~4 of 10 questions. Known questions score equal-or-better off (3_1 85%>75%, 2_2/1_2 off).
AGENT_DEMO_ENABLE_THINKING=0
# Per-question thinking allowlist (comma-separated question ids, e.g. 3_3,2_3). Empty = none.
# Listed ids run the main agent loop with thinking ON without any code change; skills stay off.
AGENT_DEMO_THINKING_QUESTION_IDS=
# Single-question probe for platform variance debugging. When set (comma-separated ids,
# e.g. 3_2 or 3_2,1_4), ONLY the listed questions run the full solve flow; every other
# question instantly returns an empty answer (zero model calls, zero skill subprocesses).
# A whitelist matching no real id is ignored with a loud warning and the run stays FULL,
# so a typo can never submit all-empty. Leaderboard keeps the LATEST submission's score:
# the closing/final submission MUST be a full run with this line left commented out.
# AGENT_DEMO_ONLY_QUESTION_IDS=3_2
# Transient gateway error retries (exponential backoff).
AGENT_DEMO_MAX_RETRIES=2
AGENT_DEMO_RETRY_BACKOFF=1.0
# Cross-question concurrency: ENABLED at 3 to fight the 1-hour cap (serial run only reached
# ~4 of 10 questions). Wall-clock changes from sum-of-questions toward max-of-questions.
# WARNING: peak gateway in-flight requests ≈ concurrency × per-question skill workers
# (PROMPT_LEARN_WORKERS / SPEC_QA_WORKERS default 4 → peak ≈ 12). If the gateway throttles
# or RemoteDisconnect appears, lower this value.
AGENT_DEMO_CONCURRENCY=1

# PO compliance (3_2) is exact/all-or-nothing. The deterministic keyword code
# matches the PUBLIC fixture but CANNOT generalise approval wording on hidden
# variants — it confidently mis-reads rephrased approvals (e.g. a "确认" inside
# "暂不并入本次确认" reads as an approval), and one slip is a zero. Proven by
# source/eval/fixtures/po_variant_{A,B}: keyword code FAILS both; the split
# below passes public + both variants exactly, 9/9 stable runs (thinking OFF):
#   scope coverage -> CODE (enumerated vendor scope, authoritative)
#   approval intent -> per-PO model extraction + CODE role/validity/date checks
# Per-PO calls keep each request a few KB (256k-window safe). Validate with:
#   set -a; . .env.dashscope; set +a; PO_AUDIT_USE_LLM=1 python -m source.eval.po_audit_check
PO_AUDIT_USE_LLM=1
# Narrow structured extraction needs no reasoning budget; OFF keeps every call
# fast so the run stays inside the 600s skill cap (no deadline fallback to the
# brittle keyword path) and avoids max_tokens truncating the JSON.
PO_AUDIT_DEEP_THINKING=0
# Per-PO concurrency inside the skill. Peak gateway in-flight ≈ AGENT_DEMO_
# CONCURRENCY × this; keep modest so the gateway does not throttle.
PO_AUDIT_WORKERS=4

# Sensitive scan (2_2) is graded positionally+exactly ("ratio"): one image that
# never gets transcribed makes 1-4 fields off-by-a-few, and every off field
# scores ZERO. The platform grades ~10 questions at once, so the gateway throws
# transient HTTP 500 / RemoteDisconnected storms (observed: a bare "HTTP Error
# 500" dropped one image -> question went to 0). The skill now re-attempts every
# still-failing image in ROUNDS until it succeeds or the ~570s budget runs out,
# with exponential backoff + full jitter. These knobs are the code defaults,
# surfaced for on-platform tuning (raise BACKOFF_CAP if storms last longer):
SENSITIVE_SCAN_WORKERS=1
SENSITIVE_SCAN_RETRIES=200
SENSITIVE_SCAN_RETRY_BACKOFF=1.0
SENSITIVE_SCAN_RETRY_BACKOFF_CAP=20.0
# The category set + output order are read from the question's 输出格式 line at
# runtime (the variant says "敏感信息类型可能增加"). The 4 known types reuse the
# validated regexes (no model call); only a genuinely NEW type's regex is
# synthesised by the model, capped at this many tokens (the request is tiny).
SENSITIVE_SCAN_REGEX_MAX_TOKENS=256
